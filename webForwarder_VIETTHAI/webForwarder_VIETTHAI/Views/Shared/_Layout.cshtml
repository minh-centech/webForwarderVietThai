@using System.Security.Claims
@{
    var tenKH = User.FindFirst(ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "";
    var vaiTro = User.IsInRole(TaiKhoan.RoleAdmin) ? "Quản trị" : "Khách hàng";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VIETTHAI Forwarder</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app">
        <input type="checkbox" id="sidebarToggle" class="app-toggle-state" />

        <partial name="_Sidebar" />

        <label for="sidebarToggle" class="app-backdrop" aria-hidden="true"></label>

        <div class="app-main">
            <header class="app-topbar">
                <label for="sidebarToggle" class="app-menu-btn" title="Menu">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </label>

                <form class="app-search" asp-controller="QuanLyKhachHang" asp-action="Index" method="get" role="search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" name="keyword" placeholder="Tìm khách hàng..." />
                </form>

                <div class="app-topbar__right">
                    <details class="app-user">
                        <summary class="app-user__summary">
                            <img class="app-user__avatar" src="~/images/avatar.svg" alt="" />
                            <span class="app-user__meta">
                                <span class="app-user__name">@tenKH</span>
                                <span class="app-user__role">@vaiTro</span>
                            </span>
                            <i class="bi bi-chevron-down app-user__chevron" aria-hidden="true"></i>
                        </summary>
                        <div class="app-user__menu">
                            @if (!User.IsInRole(TaiKhoan.RoleAdmin))
                            {
                                <a class="app-user__item" asp-controller="KhachHang" asp-action="CapNhat">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Cập nhật thông tin
                                </a>
                            }
                            <form asp-controller="Login" asp-action="Logout" method="post" class="app-user__logout">
                                <button type="submit" class="app-user__item">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </details>
                </div>
            </header>

            <main class="app-content">
                @if (TempData["Success"] is string ok)
                {
                    <div class="app-alert app-alert--success" role="status">
                        <i class="bi bi-check-circle" aria-hidden="true"></i><span>@ok</span>
                    </div>
                }
                @if (TempData["Error"] is string err)
                {
                    <div class="app-alert app-alert--danger" role="alert">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>@err</span>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="app-footer">© @DateTime.Now.Year VIETTHAI Forwarder</footer>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
