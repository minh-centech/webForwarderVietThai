@model KhachHangListViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý khách hàng";
    var r = Model.Result;
    var from = r.Total == 0 ? 0 : (r.Page - 1) * r.PageSize + 1;
    var to = Math.Min(r.Page * r.PageSize, r.Total);
}

<div class="page-head">
    <div>
        <h1>Quản lý khách hàng</h1>
    </div>
    <div class="page-head__actions">
        <a class="app-btn app-btn--primary" asp-action="Them">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm khách hàng
        </a>
    </div>
</div>

<form method="get" class="app-card app-filter">
    <label>
        Tìm kiếm
        <input type="search" name="keyword" class="app-input" value="@Model.Keyword" placeholder="Mã, tên, email, số điện thoại" style="width: 320px; max-width: 100%;" />
    </label>
    <button type="submit" class="app-btn app-btn--primary"><i class="bi bi-search" aria-hidden="true"></i> Tìm</button>
    @if (!string.IsNullOrWhiteSpace(Model.Keyword))
    {
        <a class="app-btn" asp-action="Index">Xoá lọc</a>
    }
</form>

<div class="app-card">
    @if (r.Items.Count == 0)
    {
        <div class="app-empty">
            <i class="bi bi-people" aria-hidden="true"></i>
            Không có khách hàng nào@(string.IsNullOrWhiteSpace(Model.Keyword) ? "" : " khớp từ khoá").
        </div>
    }
    else
    {
        <div class="app-table-wrap">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Mã KH</th>
                        <th>Tên khách hàng</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th>Loại</th>
                        <th>Đại lý</th>
                        <th>Ngày tạo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kh in r.Items)
                    {
                        <tr>
                            <td><strong>@kh.MaKH</strong></td>
                            <td>@kh.TenKH</td>
                            <td>@(kh.Email ?? "-")</td>
                            <td>@(kh.SoDienThoai ?? "-")</td>
                            <td>
                                <span class="badge @(kh.LoaiTaiKhoan == TaiKhoan.LoaiAdmin ? "badge--blue" : "badge--green")">@TaiKhoan.TenLoai(kh.LoaiTaiKhoan)</span>
                            </td>
                            <td>@Model.TenDaiLy(kh.IDDanhMucDaiLy)</td>
                            <td>@(kh.CreateDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                <div class="row-actions">
                                    <a class="app-btn app-btn--sm" asp-action="Sua" asp-route-id="@kh.ID" title="Sửa">
                                        <i class="bi bi-pencil" aria-hidden="true"></i> Sửa
                                    </a>
                                    <a class="app-btn app-btn--sm" asp-action="DatLaiMatKhau" asp-route-id="@kh.ID" title="Đặt lại mật khẩu">
                                        <i class="bi bi-key" aria-hidden="true"></i>
                                    </a>
                                    <form asp-action="Xoa" asp-route-id="@kh.ID" method="post"
                                          onsubmit="return confirm('Xoá khách hàng @kh.MaKH? Thao tác này không hoàn tác được.');">
                                        <input type="hidden" name="maKH" value="@kh.MaKH" />
                                        <button type="submit" class="app-btn app-btn--sm app-btn--danger" title="Xoá">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pager">
            <span class="pager__info">Hiển thị @from–@to trong @r.Total</span>
            @if (r.TotalPages > 1)
            {
                <nav class="pager__nav" aria-label="Phân trang">
                    <a class="@(r.Page <= 1 ? "is-disabled" : "")" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-page="@(r.Page - 1)">‹</a>
                    @for (var p = 1; p <= r.TotalPages; p++)
                    {
                        if (p == r.Page)
                        {
                            <span class="is-current">@p</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-page="@p">@p</a>
                        }
                    }
                    <a class="@(r.Page >= r.TotalPages ? "is-disabled" : "")" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-page="@(r.Page + 1)">›</a>
                </nav>
            }
        </div>
    }
</div>
