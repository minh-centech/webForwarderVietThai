@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth">
    <div class="auth-wrap">
        <div class="auth-card">

            <div class="auth-brand">
                <span class="auth-brand__mark"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                <span class="auth-brand__name">VIETTHAI Forwarder</span>
            </div>

            <h1 class="auth-title">Welcome!</h1>

            <form asp-action="Index" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                </div>

                <div class="auth-field">
                    <label asp-for="MaKH">Mã khách hàng</label>
                    <div class="auth-control">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <input asp-for="MaKH" class="auth-input" autocomplete="username" />
                    </div>
                    <span asp-validation-for="MaKH"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="MatKhau">Mật khẩu</label>
                    <div class="auth-control">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input asp-for="MatKhau" class="auth-input auth-input--password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                        <button type="button" class="auth-eye" aria-label="Hiện hoặc ẩn mật khẩu"
                                onclick="var i=this.parentElement.querySelector('input');i.type=i.type==='password'?'text':'password';this.firstElementChild.className=i.type==='password'?'bi bi-eye':'bi bi-eye-slash';">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau"></span>
                </div>

                <div class="auth-row">
                    <label class="auth-check">
                        <input asp-for="RememberMe" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <a asp-action="QuenMatKhau" class="auth-link">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="auth-btn">Đăng nhập</button>
            </form>

            <div class="auth-divider">Cần hỗ trợ?</div>
            <p class="auth-help">Liên hệ bộ phận IT để được hỗ trợ.</p>
        </div>

        <p class="auth-foot">© @DateTime.Now.Year VIETTHAI Forwarder</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
